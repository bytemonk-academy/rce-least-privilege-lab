{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ResumeObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::${RESUME_BUCKET}/*"
    },
    {
      "Sid": "HrIntegrationEmployeeArchive",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::${ARCHIVE_BUCKET}/*"
    }
  ]
}
